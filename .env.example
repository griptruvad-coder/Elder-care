# Copy to .env for local use (never commit .env). On Render, set these in the Environment tab.
DATABASE_URL=postgres://apnasa:apnasa@localhost:5432/apnasa
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_EMAILS=founder@example.com

# Google login — console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web)
GOOGLE_CLIENT_ID=

# Razorpay — dashboard.razorpay.com → Account & Settings → API Keys (use Test mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Filled by: npm run razorpay:plans
RAZORPAY_PLAN_BASIC=
RAZORPAY_PLAN_PREMIUM=
RAZORPAY_PLAN_SUPER_PREMIUM=

# Optional: care team WhatsApp with country code, digits only (e.g. 919812345678)
WHATSAPP_NUMBER=
